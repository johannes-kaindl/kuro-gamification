{
  "name": "kuro-gamification",
  "version": "1.0.0",
  "private": true,
  "description": "Neurodivergence-friendly gamification plugin for Obsidian.",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Jay",
    "url": "https://github.com/v6t2b9"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "obsidian-md",
    "gamification",
    "adhd",
    "autism",
    "neurodivergent",
    "xp",
    "streaks",
    "habit-tracking",
    "typescript"
  ],
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -p tsconfig.build.json -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "version-bump": "node scripts/version-bump.mjs",
    "release": "node scripts/release.mjs",
    "deploy": "npm run build && cp main.js manifest.json styles.css versions.json \"${OBSIDIAN_PLUGIN_DIR:?Set OBSIDIAN_PLUGIN_DIR to <vault>/.obsidian/plugins/kuro-gamification}\"/"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "jest": "^29.7.0",
    "obsidian": "latest",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
