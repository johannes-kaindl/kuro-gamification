{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "organizeImports": { "enabled": false },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noStaticOnlyClass": "off" }
    }
  },
  "files": { "ignore": ["node_modules", "coverage", "main.js", "scripts", "src/vendor"] },
  "overrides": [
    {
      "include": ["tests/**"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" }, "style": { "noNonNullAssertion": "off" }, "complexity": { "noUselessConstructor": "off" } } }
    }
  ]
}
